---
import Basis from '../layouts/Basis.astro';
import Bild from '../components/Bild.astro';
import SeitenHero from '../components/SeitenHero.astro';
import { getCollection } from 'astro:content';
import { alleKuechen } from '../lib/kuechen';
import reihenfolge from '../content/galerie.json';

// Reihenfolge wie in galerie.json, der Loader sortiert sonst nach id
const ids = reihenfolge.map((b) => b.id);
const bilder = (await getCollection('galerie')).sort((a, b) => ids.indexOf(a.id) - ids.indexOf(b.id));
const kuechen = await alleKuechen();
const name = (id?: string) => kuechen.find((k) => k.id === id)?.data.name;
const formate = ['4 / 5', '3 / 2', '1 / 1', '4 / 5', '3 / 2', '4 / 5', '1 / 1', '3 / 2'];
---
<Basis
  titel="Galerie"
  beschreibung="Fotos aus dem Foodcourt47 Hammerbrook: Currys von Manju, Sushi von Sushify und Pizza von Cucino Italiano."
>
  <SeitenHero foto="sushify-staebchen" vorzeile="Galerie" titel="Aus unseren <em>Küchen</em>" />

  <section class="wrap g" aria-label="Fotos">
    <p class="g-hinweis"><span class="ph">[Fotos vom Gastraum und vom Team folgen]</span></p>
    <ul class="g-liste">
      {bilder.map((b, i) => (
        <li class={`g-${i + 1}`}>
          <Bild id={b.data.foto} format={formate[i % formate.length]} sizes="(min-width: 64rem) 45vw, 100vw" />
          {name(b.data.kueche) && <p class="g-text" style={`--akzent: var(--k-${b.data.kueche})`}><em>{name(b.data.kueche)}</em></p>}
        </li>
      ))}
    </ul>
  </section>
</Basis>

<style>
  .g {
    padding-top: 4rem;
  }
  .g-hinweis {
    margin: 0 auto 4rem;
    text-align: center;
  }
  .g-liste {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .g-text {
    margin: 0.75rem 0 0;
    font-size: 1.25rem;
    color: var(--akzent);
  }
  @media (min-width: 48rem) {
    .g-liste {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 5rem 2.5rem;
      align-items: start;
    }
    .g-1 { grid-column: 1 / span 5; }
    .g-2 { grid-column: 7 / span 6; margin-top: 8rem; }
    .g-3 { grid-column: 2 / span 4; }
    .g-4 { grid-column: 7 / span 5; margin-top: -4rem; }
    .g-5 { grid-column: 1 / span 7; }
    .g-6 { grid-column: 9 / span 4; margin-top: 6rem; }
    .g-7 { grid-column: 3 / span 4; }
    .g-8 { grid-column: 7 / span 6; margin-top: 5rem; }
  }
</style>
