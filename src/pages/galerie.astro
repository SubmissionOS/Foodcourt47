---
import Basis from '../layouts/Basis.astro';
import Bild from '../components/Bild.astro';
import { getCollection } from 'astro:content';
import { alleKuechen } from '../lib/kuechen';
import reihenfolge from '../content/galerie.json';

// Reihenfolge wie in galerie.json, der Loader sortiert sonst nach id
const ids = reihenfolge.map((b) => b.id);
const bilder = (await getCollection('galerie')).sort((a, b) => ids.indexOf(a.id) - ids.indexOf(b.id));
const kuechen = await alleKuechen();
const kuecheVon = (id?: string) => kuechen.find((k) => k.id === id);
---
<Basis
  titel="Galerie"
  beschreibung="Fotos aus dem Foodcourt47 Hammerbrook: Currys von Manju, Sushi von Sushify und Pizza von Cucino Italiano."
>
  <div class="wrap">
    <header class="g-kopf">
      <span class="marke">Galerie</span>
      <h1>Aus den Küchen</h1>
      <p class="lead">Gerichte von allen drei Gleisen. <span class="ph">[Weitere Fotos vom Gastraum und Team folgen]</span></p>
    </header>

    <ul class="mosaik">
      {bilder.map((b, i) => {
        const k = kuecheVon(b.data.kueche);
        return (
          <li class:list={[`m-${i + 1}`, k && `linie-${k.id}`]}>
            <Bild
              src={b.data.src || null}
              alt={b.data.alt}
              breite={b.data.breite}
              hoehe={b.data.hoehe}
              platzhalter={b.data.platzhalter}
              eager={i === 0}
              sizes="(min-width: 64rem) 50vw, 100vw"
            />
            {k && (
              <p class="m-unterschrift">
                <span class="gleis" aria-hidden="true">{k.data.gleis}</span>
                <a href={`/${k.id}`}>{k.data.name}</a>
              </p>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</Basis>

<style>
  .g-kopf {
    padding-block: 3rem 2.5rem;
  }
  .g-kopf h1 {
    margin-bottom: 1rem;
  }

  /* Ungleichmäßiges Mosaik: ein großes Bild, der Rest versetzt */
  .mosaik {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mosaik li {
    margin: 0;
  }
  .mosaik :global(.bild) {
    border-bottom: var(--strich) solid var(--linie);
  }
  .m-unterschrift {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.6rem 0 0;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .m-unterschrift .gleis {
    --g: 1.5rem;
    font-size: 0.9rem;
  }
  .m-unterschrift a {
    text-decoration: none;
  }
  .m-unterschrift a:hover {
    text-decoration: underline;
  }

  @media (min-width: 48rem) {
    .mosaik {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 3rem 2rem;
    }
    .m-1 { grid-column: 1 / span 8; }
    .m-2 { grid-column: 9 / span 4; align-self: end; }
    .m-3 { grid-column: 2 / span 5; }
    .m-4 { grid-column: 7 / span 6; margin-top: 4rem; }
    .m-5 { grid-column: 1 / span 6; }
    .m-6 { grid-column: 7 / span 5; margin-top: 3rem; }
  }
</style>
