---
import Basis from '../layouts/Basis.astro';
import Karte from '../components/Karte.astro';
import Bild from '../components/Bild.astro';
import SeitenHero from '../components/SeitenHero.astro';
import { alleKuechen, type Kueche } from '../lib/kuechen';
import { kuecheSchema } from '../lib/schema';
import { foto, url } from '../lib/fotos';

export async function getStaticPaths() {
  const kuechen = await alleKuechen();
  return kuechen.map((k, i) => ({
    params: { kueche: k.id },
    props: { k, naechste: kuechen[(i + 1) % kuechen.length] },
  }));
}

interface Props {
  k: Kueche;
  naechste: Kueche;
}
const { k, naechste } = Astro.props;
const d = k.data;
const domain = new URL(d.website).hostname;
const [heroId, ...weitere] = d.fotos;
const heroFoto = await foto(heroId);
---
<Basis
  titel={`${d.name}: ${d.kategorie}`}
  beschreibung={`${d.name} im Foodcourt47 Hammerbrook: ${d.claim} ${d.karten.map((c) => `${c.titel} ${c.zeit}`).join(', ')}.`}
  akzent={k.id}
  schema={await kuecheSchema(k)}
  ogBild={url(heroFoto, 1600)}
>
  <SeitenHero foto={heroId} titel={d.name} satz={d.claim} />

  <section class="wrap einleitung" aria-label={`Über ${d.name}`}>
    <div class="ein-text einblenden">
      <p class="ein-gross">{d.einleitung[0]}</p>
      {d.einleitung.slice(1).map((p) => <p>{p}</p>)}
      <p class="ein-vegan">Auf Wunsch bereiten wir jedes Gericht vegan zu.</p>
      <a class="weiter" href={d.website} target="_blank" rel="noopener">{domain}<span class="nur-sr"> (öffnet neues Fenster)</span></a>
    </div>
    {weitere.length > 0 && (
      <div class="ein-bilder">
        {weitere.slice(0, 2).map((id, i) => (
          <Bild id={id} format={i === 0 ? '4 / 5' : '1 / 1'} sizes="(min-width: 64rem) 25vw, 50vw" class={`ein-bild-${i + 1}`} />
        ))}
      </div>
    )}
  </section>

  {d.karten.map((c) => (
    <section class="karte-block" id={c.id} aria-labelledby={`${c.id}-titel`}>
      <header class="karte-kopf wrap">

        <h2 id={`${c.id}-titel`}>{c.titel}</h2>
        <p class="karte-zeit">{c.zeit}</p>
      </header>
      <div class="wrap">
        <Karte karte={c} spalten={c.sektionen.length > 2} />
      </div>
    </section>
  ))}

  <section class="naechste" style={`--akzent: var(--k-${naechste.id})`} aria-label="Weitere Küche">
    <a class="naechste-link wrap" href={`/${naechste.id}`}>

      <span class="naechste-name">{naechste.data.name}</span>
      <span class="weiter">Nebenan im Foodcourt47</span>
    </a>
  </section>
</Basis>

<style>
  .einleitung {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3.5rem;
    padding-block: var(--luft);
    align-items: center;
  }
  .ein-gross {
    font-family: var(--serif);
    font-size: clamp(1.7rem, 2.8vw, 2.4rem);
    line-height: 1.25;
    max-width: 26ch;
  }
  .ein-vegan {
    margin: 1.75rem 0 2rem;
    font-family: var(--serif);
    font-size: 1.4rem;
    color: var(--akzent);
  }
  .ein-bilder {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 1rem;
    align-items: end;
  }
  @media (min-width: 64rem) {
    .einleitung {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 6rem;
    }
  }

  .karte-block {
    padding-block: var(--luft);
    border-top: 1px solid #1d1b181f;
    scroll-margin-top: 5rem;
  }
  .karte-block:nth-of-type(odd) {
    background: #efe7da;
  }
  .karte-kopf {
    margin-bottom: 3.5rem;
    text-align: center;
  }
  .karte-zeit {
    margin: 0.9rem auto 0;
    color: var(--rauch);
    letter-spacing: 0.04em;
  }

  .naechste {
    border-top: 1px solid #1d1b181f;
  }
  .naechste-link {
    display: grid;
    justify-items: center;
    padding-block: var(--luft);
    text-align: center;
    text-decoration: none;
  }
  .naechste-name {
    margin-bottom: 1.75rem;
    font-family: var(--serif);
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 1;
    transition: color 400ms var(--weich);
  }
  .naechste-link:hover .naechste-name {
    color: var(--akzent);
  }
</style>
