---
import Basis from '../layouts/Basis.astro';
import SeitenHero from '../components/SeitenHero.astro';
import { site } from '../lib/site';
import { markiere } from '../lib/format';
---
<Basis
  titel="Kontakt und Anfahrt"
  beschreibung="Kontakt und Anfahrt zum Foodcourt47 in Hamburg-Hammerbrook: Adresse, Telefon, E-Mail und Öffnungszeiten."
>
  <SeitenHero foto="hero-gastraum" vorzeile="Kontakt" titel="Besuchen Sie <em>uns</em>" satz="Mitten in Hamburg-Hammerbrook." />

  <section class="wrap k" aria-label="Kontaktdaten">
    <div class="k-spalte einblenden">
      <h2 class="k-h">Adresse</h2>
      <p class="k-gross">
        {site.name}<br />
        <Fragment set:html={markiere(site.adresse.strasse)} /><br />
        <Fragment set:html={markiere(`${site.adresse.plz} ${site.adresse.ort}`)} />
      </p>
      <p set:html={markiere(site.anfahrt)} />
    </div>
    <div class="k-spalte einblenden">
      <h2 class="k-h">Zeiten</h2>
      <p class="k-gross">Mittag {site.mittag.tage}<br />11 bis 16 Uhr</p>
      <p set:html={markiere(site.oeffnungszeiten)} />
    </div>
    <div class="k-spalte einblenden">
      <h2 class="k-h">Kontakt</h2>
      <p class="k-gross"><Fragment set:html={markiere(site.telefon)} /><br /><Fragment set:html={markiere(site.email)} /></p>
      <a class="knopf" href="/reservieren">Tisch reservieren</a>
    </div>
  </section>

  <div class="wrap">
    <div class="k-karte">
      <span class="ph">[Karte: Kartenausschnitt erst nach Einwilligung laden oder als statisches Bild einbinden]</span>
    </div>
  </div>
</Basis>

<style>
  .k {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3.5rem;
    padding-block: var(--luft);
  }
  .k-h {
    margin-bottom: 1rem;
    font-style: italic;
    font-size: 1.5rem;
    color: var(--messing);
  }
  .k-gross {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    line-height: 1.3;
  }
  .k-karte {
    display: grid;
    place-items: center;
    min-height: 26rem;
    padding: 2rem;
    text-align: center;
    background: var(--leinen);
  }
  @media (min-width: 64rem) {
    .k {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 4rem;
    }
  }
</style>
