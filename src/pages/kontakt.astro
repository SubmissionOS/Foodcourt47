---
import Basis from '../layouts/Basis.astro';
import SeitenHero from '../components/SeitenHero.astro';
import Bild from '../components/Bild.astro';
import { site, zeiten, mapsUrl } from '../lib/site';
import { markiere } from '../lib/format';

const tel = 'tel:+49' + site.telefon.replace(/^0/, '').replace(/\s/g, '');
---
<Basis
  titel="Kontakt und Anfahrt"
  beschreibung="Kontakt und Anfahrt zum Foodcourt47 in Hamburg-Hammerbrook: Adresse, Telefon, E-Mail und Öffnungszeiten."
>
  <SeitenHero foto="hero-gastraum" titel="Besuchen Sie uns" satz="Mitten in Hamburg-Hammerbrook." />

  <section class="wrap k" aria-label="Kontaktdaten">
    <div class="k-spalte einblenden">
      <h2 class="k-h">Adresse</h2>
      <p class="k-gross">
        {site.name}<br />
        <Fragment set:html={markiere(site.adresse.strasse)} /><br />
        <Fragment set:html={markiere(`${site.adresse.plz} ${site.adresse.ort}`)} />
      </p>
      <p>{site.anfahrt}</p>
      <a class="weiter" href={mapsUrl} target="_blank" rel="noopener">Route planen<span class="nur-sr"> (Google Maps, neues Fenster)</span></a>
    </div>
    <div class="k-spalte einblenden">
      <h2 class="k-h">Zeiten</h2>
      <p class="k-gross">Mittagstisch<br />Mo–Fr 11–16 Uhr</p>
      <p>{zeiten.map((z) => <>{z}<br /></>)}Abendkarte ab 17 Uhr</p>
    </div>
    <div class="k-spalte einblenden">
      <h2 class="k-h">Kontakt</h2>
      <p class="k-gross"><a href={tel}>{site.telefon}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <a class="knopf" href="/reservieren">Tisch reservieren</a>
    </div>
  </section>

  <div class="wrap">
    <Bild id="hero-gastraum" format="21 / 9" sizes="100vw" />
  </div>
</Basis>

<style>
  .k {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3.5rem;
    padding-block: var(--luft);
  }
  .k-h {
    margin-bottom: 1rem;
    font-size: 1.05rem;
    letter-spacing: 0;
    color: var(--messing);
  }
  .k-gross {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.3rem, 1.9vw, 1.55rem);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  @media (min-width: 64rem) {
    .k {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 4rem;
    }
  }
</style>
