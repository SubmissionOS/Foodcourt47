---
import Basis from '../layouts/Basis.astro';
import Tafel, { type TafelZeile } from '../components/Tafel.astro';
import Bild from '../components/Bild.astro';
import { alleKuechen, mittagsgerichte, abPreis } from '../lib/kuechen';
import { preis, markiere } from '../lib/format';
import { site } from '../lib/site';
import { foodcourtSchema } from '../lib/schema';

const kuechen = await alleKuechen();
const guenstigster = abPreis(kuechen);

const zeilen: TafelZeile[] = kuechen.map((k) => {
  const gerichte = mittagsgerichte(k);
  return {
    zeit: site.mittag.von,
    gleis: k.data.gleis,
    linie: k.id,
    ziel: k.data.name,
    via: gerichte.map((g) => g.name).join(' · '),
    preis: preis(abPreis([k])),
    href: `/${k.id}`,
  };
});
---
<Basis
  titel="Start"
  beschreibung={site.beschreibung}
  schema={foodcourtSchema(kuechen)}
>
  <div class="wrap">
    <section class="start" aria-labelledby="start-titel">
      <div class="start-text">
        <span class="marke">Hammerbrook · Hamburg</span>
        <h1 id="start-titel">
          <span class="h1-zeile">Foodcourt<span class="h1-nr">47</span></span>
        </h1>
        <p class="lead">
          Pizza von Cucino Italiano, Currys von Manju, Sushi von Sushify. Drei Küchen unter einem Dach, mittags {site.mittag.tage} ab {preis(guenstigster)}.
        </p>
        <div class="start-knoepfe">
          <a class="knopf" href="/reservieren">Tisch reservieren <span class="pfeil" aria-hidden="true">→</span></a>
          <a class="knopf knopf--hell" href="/speisekarte">Speisekarte</a>
        </div>
      </div>
      <div class="start-tafel">
        <Tafel titel="Abfahrt Mittag · Gleis 1 bis 3" zeilen={zeilen} />
      </div>
    </section>
  </div>

  <div class="wrap">
    <section class="zeile heute" aria-labelledby="heute-titel">
      <span class="kenn">Heute</span>
      <div>
        <div class="heute-kopf">
          <h2 id="heute-titel">Mittag am <span data-heute-name>Werktag</span></h2>
          <p class="heute-status"><span data-mittag-satz>Mittagsangebote {site.mittag.tage} von 11 bis 16 Uhr.</span></p>
        </div>
        <div class="heute-raster">
          {kuechen.map((k) => (
            <section class={`heute-kueche linie-${k.id}`} aria-labelledby={`heute-${k.id}`}>
              <h3 id={`heute-${k.id}`}>
                <span class="gleis" aria-hidden="true">{k.data.gleis}</span>
                <a href={`/${k.id}`}>{k.data.name}</a>
              </h3>
              <ul>
                {mittagsgerichte(k).map((g) => (
                  <li>
                    <span class="hk-name">{g.name}</span>
                    <span class="hk-preis mono" set:html={markiere(preis(g.preis))} />
                    {g.beschreibung && <span class="hk-text">{g.beschreibung}</span>}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
        <p class="heute-mehr"><a href="/mittag">Alle Mittagsangebote der Woche</a></p>
      </div>
    </section>

    <section class="zeile" aria-labelledby="gleise-titel">
      <span class="kenn">Gleise</span>
      <div>
        <h2 id="gleise-titel" class="gleise-titel">Drei Küchen, drei Gleise</h2>
        <ol class="gleise">
          {kuechen.map((k, i) => (
            <li class:list={['gleis-band', `linie-${k.id}`, { 'gleis-band--rechts': i % 2 === 1 }]}>
              <div class="gb-text">
                <div class="gb-kopf">
                  <span class="gleis gb-gleis" aria-hidden="true">{k.data.gleis}</span>
                  <div>
                    <span class="gb-kategorie mono">Gleis {k.data.gleis} · {k.data.kategorie}</span>
                    <h3 class="gb-name">{k.data.name}</h3>
                  </div>
                </div>
                <p class="gb-claim">{k.data.claim}</p>
                <p>{k.data.einleitung[0]}</p>
                <a class="knopf knopf--hell" href={`/${k.id}`}>Karte von {k.data.name} <span class="pfeil" aria-hidden="true">→</span></a>
              </div>
              <Bild
                class="gb-bild"
                src={k.data.bild?.src}
                alt={k.data.bild?.alt ?? ''}
                breite={k.data.bild?.breite ?? 1024}
                hoehe={k.data.bild?.hoehe ?? 710}
                platzhalter={k.data.bildPlatzhalter}
                sizes="(min-width: 64rem) 40rem, 100vw"
              />
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="zeile" aria-labelledby="wissen-titel">
      <span class="kenn">Gut zu wissen</span>
      <div>
        <h2 id="wissen-titel" class="nur-sr">Gut zu wissen</h2>
        <dl class="wissen">
          <div>
            <dt>Vegan</dt>
            <dd>Jedes Gericht bekommen Sie auf Wunsch vegan. Sagen Sie es bei der Bestellung.</dd>
          </div>
          <div>
            <dt>Familien</dt>
            <dd>Kinder sind willkommen. Bei drei Küchen findet jeder am Tisch etwas.</dd>
          </div>
          <div>
            <dt>Mittag</dt>
            <dd>{site.mittag.tage} von 11 bis 16 Uhr gelten feste Mittagspreise in allen drei Küchen.</dd>
          </div>
        </dl>
      </div>
    </section>
  </div>

  <section class="reservieren" aria-labelledby="res-titel">
    <div class="wrap res-innen">
      <div>
        <span class="marke">Reservierung</span>
        <h2 id="res-titel">Platz für Ihr Team, Ihre Familie oder zwei.</h2>
      </div>
      <div class="res-rechts">
        <p>Reservieren Sie online. Die Buchung läuft über das Reservierungssystem aleno.</p>
        <a class="knopf res-knopf" href={site.reservierungUrl} target="_blank" rel="noopener">
          Tisch reservieren <span class="pfeil" aria-hidden="true">↗</span>
          <span class="nur-sr">(öffnet neues Fenster)</span>
        </a>
        <p class="res-adresse">
          <span set:html={markiere(`${site.adresse.strasse}, ${site.adresse.plz} ${site.adresse.ort}`)} /><br />
          Telefon <span set:html={markiere(site.telefon)} />
        </p>
      </div>
    </div>
  </section>
</Basis>

<style>
  /* Start */
  .start {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    padding-block: 2.5rem 4rem;
  }
  h1 {
    margin-bottom: 1.5rem;
  }
  .h1-nr {
    display: inline-block;
    margin-left: 0.08em;
    padding: 0.12em 0.12em 0;
    background: var(--tinte);
    color: var(--grund);
    font-family: var(--mono);
    font-weight: 600;
    font-size: 0.72em;
    letter-spacing: -0.04em;
    line-height: 1;
    vertical-align: 0.12em;
  }
  .start-knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (min-width: 64rem) {
    .start {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: end;
      gap: 3.5rem;
      padding-block: 4.5rem 6rem;
    }
    h1 {
      font-size: clamp(3.25rem, 5.5vw, 5.5rem);
    }
  }

  /* Heute */
  .heute-kopf {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .heute-status {
    margin: 0;
    font-size: 1.1rem;
  }
  :global(html[data-mittag='laeuft']) .heute-status span {
    background: var(--signal);
    padding: 0.1em 0.3em 0;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .heute-raster {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  .heute-kueche h3 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: var(--strich) solid var(--linie);
  }
  .heute-kueche h3 a {
    text-decoration: none;
  }
  .heute-kueche h3 a:hover {
    text-decoration: underline;
  }
  .heute-kueche .gleis {
    --g: 2rem;
  }
  .heute-kueche ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .heute-kueche li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid #12191f26;
  }
  .hk-name {
    font-weight: 800;
  }
  .hk-preis {
    font-weight: 600;
  }
  .hk-text {
    grid-column: 1 / -1;
    font-size: 0.9rem;
    color: var(--tinte-2);
  }
  .heute-mehr {
    margin: 1.75rem 0 0;
    font-weight: 700;
  }

  @media (min-width: 64rem) {
    .heute-raster {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
    }
    .heute-kueche {
      padding-inline: 1.5rem;
      border-left: 1px solid #12191f33;
    }
    .heute-kueche:first-child {
      padding-left: 0;
      border-left: 0;
    }
    .heute-kueche:last-child {
      padding-right: 0;
    }
  }

  /* Gleise */
  .gleise-titel {
    margin-bottom: 2.5rem;
  }
  .gleise {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .gleis-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
    padding-block: 2.5rem;
    border-top: 1px solid #12191f33;
  }
  .gleis-band:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .gb-kopf {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .gb-gleis {
    --g: 4.25rem;
  }
  .gb-kategorie {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--linie);
    font-weight: 600;
  }
  .gb-name {
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 900;
    letter-spacing: -0.03em;
  }
  .gb-claim {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
  }

  @media (min-width: 64rem) {
    .gleis-band {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
      gap: 4rem;
      padding-block: 3.5rem;
    }
    .gleis-band--rechts {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    }
    .gleis-band--rechts .gb-text {
      order: 2;
    }
  }

  /* Gut zu wissen */
  .wissen {
    display: grid;
    gap: 1.5rem;
    margin: 0;
  }
  .wissen div {
    border-left: var(--strich) solid var(--tinte);
    padding-left: 1rem;
  }
  .wissen dt {
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.3rem;
  }
  .wissen dd {
    margin: 0;
    font-size: 1.1rem;
    max-width: 34ch;
  }
  @media (min-width: 48rem) {
    .wissen {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  /* Reservieren */
  .reservieren {
    margin-top: 2rem;
    margin-bottom: -6rem;
    background: var(--grund-tief);
    border-top: var(--strich) solid var(--tinte);
  }
  .res-innen {
    display: grid;
    gap: 2rem;
    padding-block: 3.5rem 4.5rem;
  }
  .res-innen h2 {
    font-size: clamp(2rem, 5vw, 3.75rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    max-width: 14ch;
  }
  .res-rechts p {
    font-size: 1.1rem;
  }
  .res-adresse {
    margin-top: 1.75rem;
    font-size: 0.95rem !important;
  }
  @media (min-width: 64rem) {
    .res-innen {
      grid-template-columns: 7fr 5fr;
      align-items: end;
      gap: 4rem;
      padding-block: 5rem 6rem;
    }
  }
</style>
