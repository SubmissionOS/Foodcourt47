---
import Basis from '../layouts/Basis.astro';
import HeroStart from '../components/HeroStart.astro';
import Bild from '../components/Bild.astro';
import Foto from '../components/Foto.astro';
import { getCollection } from 'astro:content';
import { alleKuechen, abPreis } from '../lib/kuechen';
import { preis, markiere } from '../lib/format';
import { site } from '../lib/site';
import { foodcourtSchema } from '../lib/schema';
import { serie } from '../lib/serie';

const kuechen = await alleKuechen();
const ab = preis(abPreis(kuechen));


const reihenfolge = (await import('../content/galerie.json')).default.map((g) => g.id);
const streifen = (await getCollection('galerie')).sort((a, b) => reihenfolge.indexOf(a.id) - reihenfolge.indexOf(b.id));

---
<Basis titel="Start" beschreibung={site.beschreibung} schema={await foodcourtSchema(kuechen)} heroFotos={serie.map((s) => s.foto)} heroArt="start" ogFoto="cucino-pizza">
  <HeroStart />

  <div class="kuechen">
    {kuechen.map((k, i) => (
      <section class:list={['kueche', `kueche--${i + 1}`]} style={`--akzent: var(--k-${k.id})`} aria-labelledby={`k-${k.id}`}>
        <Bild id={k.data.fotos[0]} format={i === 1 ? '4 / 5' : '5 / 4'} sizes="(min-width: 64rem) 55vw, 100vw" class="kueche-bild" />
        <div class="kueche-text einblenden">
          <h2 id={`k-${k.id}`}>{k.data.name}</h2>
          <p>{k.data.kurztext}</p>
          <a class="knopf knopf--linie kueche-link" href={`/${k.id}`}>Zur Karte<span class="nur-sr"> von {k.data.name}</span></a>
        </div>
      </section>
    ))}
  </div>

  <section class="mittag dunkel" aria-labelledby="mittag-titel">
    <div class="wrap mittag-innen einblenden">
      <h2 id="mittag-titel">Mittags von Montag bis Freitag</h2>
      <p class="lead">Zwischen 11 und 16 Uhr hat jede Küche drei Gerichte zum festen Preis, ab {ab}. Auf Wunsch ist jedes davon vegan.</p>
      <a class="weiter" href="/mittag">Der Mittagstisch</a>
    </div>
  </section>

  <section class="streifen" aria-labelledby="streifen-titel">
    <div class="wrap streifen-kopf">
      <h2 id="streifen-titel" class="streifen-titel">Aus unseren Küchen</h2>
      <a class="weiter" href="/galerie">Zur Galerie</a>
    </div>
    <ul class="streifen-liste" tabindex="0" aria-label="Fotos, seitlich scrollbar">
      {streifen.map((g, i) => (
        <li>
          <Bild id={g.data.foto} format={i % 3 === 1 ? '3 / 4' : '4 / 5'} sizes="(min-width: 64rem) 26vw, 70vw" einblenden={false} />
        </li>
      ))}
    </ul>
  </section>

  <section class="abschluss dunkel" aria-labelledby="abschluss-titel">
    <div class="abschluss-bild zoom" data-placeholder-photo="PLACEHOLDER_PHOTO">
      <Foto id="tisch-teilen" widths={[768, 1280, 1920, 2400]} sizes="100vw" art="hero" alt="" />
    </div>
    <div class="wrap abschluss-text einblenden">
      <h2 id="abschluss-titel">Wir halten Ihren Tisch bereit.</h2>
      <p class="lead">Für die Mittagspause mit Kollegen, den Abend mit der Familie oder zu zweit.</p>
      <a class="knopf knopf--hell" href="/reservieren">Tisch reservieren</a>
      <p class="abschluss-adresse" set:html={markiere(`${site.adresse.strasse} · ${site.adresse.plz} ${site.adresse.ort}`)} />
    </div>
  </section>
</Basis>

<style>
  /* Küchen: Foto, Name, zwei Sätze, Link. Funktioniert ohne Hover. */
  .kuechen {
    display: grid;
    gap: calc(var(--luft) * 0.8);
    max-width: var(--breite);
    margin-inline: auto;
    padding: calc(var(--luft) * 0.8) var(--rand) 0;
  }
  .kueche {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
    align-items: center;
  }
  .kueche-text h2 {
    margin-bottom: 1.1rem;
  }
  .kueche-text h2::before {
    content: '';
    display: block;
    width: 3rem;
    height: 4px;
    margin-bottom: 1.25rem;
    background: var(--akzent);
  }
  .kueche-text p {
    font-size: 1.15rem;
    max-width: 34ch;
  }
  .kueche-link {
    width: 100%;
    min-height: 3.5rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 48rem) {
    .kueche-link {
      width: auto;
    }
  }
  @media (min-width: 64rem) {
    .kueche {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: 6rem;
    }
    .kueche--2 {
      grid-template-columns: minmax(0, 4fr) minmax(0, 5fr);
    }
    .kueche--2 :global(.kueche-bild) {
      order: 2;
    }
    .kueche--2 .kueche-text {
      justify-self: end;
    }
    .kueche--3 {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    }
    .kueche--3 :global(.kueche-bild) {
      margin-left: calc(var(--rand) * -1);
    }
  }

  /* Mittag */
  .mittag {
    margin-top: var(--luft);
    padding-block: var(--luft);
    text-align: center;
  }
  .mittag-innen {
    display: grid;
    justify-items: center;
  }
  .mittag h2 {
    margin-bottom: 1.75rem;
  }
  .mittag h2 em {
    color: var(--messing-hell);
  }
  .mittag .lead {
    max-width: 40ch;
    margin-bottom: 2rem;
    color: #e6ddcd;
  }

  /* Galerie-Streifen */
  .streifen {
    padding-top: var(--luft);
  }
  .streifen-kopf {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 2.5rem;
  }
  .streifen-titel em {
    color: var(--messing);
  }
  .streifen-liste {
    display: flex;
    align-items: flex-end;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    margin: 0;
    padding: 0 var(--rand) 1rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--rand);
    scrollbar-width: thin;
    scrollbar-color: var(--messing) transparent;
  }
  .streifen-liste li {
    flex: 0 0 clamp(15rem, 70vw, 24rem);
    scroll-snap-align: start;
  }
  .streifen-liste li:nth-child(3n + 2) {
    flex-basis: clamp(13rem, 58vw, 19rem);
  }

  /* Abschluss */
  .abschluss {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 90svh;
    margin-top: var(--luft);
    overflow: hidden;
  }
  .abschluss-bild {
    position: absolute;
    inset: 0;
  }
  .abschluss-bild :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .abschluss::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #121815a6;
  }
  .abschluss-text {
    position: relative;
    z-index: 1;
    padding-block: var(--luft);
    text-align: center;
    display: grid;
    justify-items: center;
  }
  .abschluss h2 {
    margin-bottom: 1.5rem;
    max-width: 14ch;
  }
  .abschluss h2 em {
    color: var(--messing-hell);
  }
  .abschluss .lead {
    max-width: 38ch;
    margin-bottom: 2.25rem;
  }
  .abschluss-adresse {
    margin: 2rem 0 0;
    font-size: 0.92rem;
    color: #e6ddcd;
  }
</style>
