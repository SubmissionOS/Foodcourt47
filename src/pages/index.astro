---
import Basis from '../layouts/Basis.astro';
import HeroStart from '../components/HeroStart.astro';
import Bild from '../components/Bild.astro';
import { getCollection } from 'astro:content';
import { alleKuechen, abPreis } from '../lib/kuechen';
import { preis, markiere } from '../lib/format';
import { site } from '../lib/site';
import { foodcourtSchema } from '../lib/schema';
import { foto, url, srcset } from '../lib/fotos';

const kuechen = await alleKuechen();
const ab = preis(abPreis(kuechen));

// PLACEHOLDER_PHOTO: Hero und Abschluss sind Stockfotos, siehe DESIGN.md
const hero = await foto('hero-gastraum');
const abschluss = await foto('tisch-teilen');

const reihenfolge = (await import('../content/galerie.json')).default.map((g) => g.id);
const streifen = (await getCollection('galerie')).sort((a, b) => reihenfolge.indexOf(a.id) - reihenfolge.indexOf(b.id));

const texte: Record<string, string> = {
  'cucino-italiano': 'Pizza und Pasta wie in Venedig. Saucen und Teig entstehen jeden Tag frisch.',
  manju: 'Indische Currys, seit 2009 in Hamburg zu Hause. Angefangen hat alles in der Wandelhalle am Hauptbahnhof.',
  sushify: 'Premium-Sushi, einzeln zubereitet aus täglich frischen Zutaten. Von Maki bis Trüffel.',
};
---
<Basis titel="Start" beschreibung={site.beschreibung} schema={foodcourtSchema(kuechen)} ogBild={url(hero, 1600)}>
  <HeroStart variante="b" />

  <section class="intro wrap" aria-label="Willkommen">
    <p class="intro-satz einblenden">
      Am selben Tisch bestellt der eine Pizza, die andere ein Curry und der Dritte Sushi. Genau dafür gibt es Foodcourt47.
    </p>
  </section>

  <div class="kuechen">
    {kuechen.map((k, i) => (
      <section class:list={['kueche', `kueche--${i + 1}`]} style={`--akzent: var(--k-${k.id})`} aria-labelledby={`k-${k.id}`}>
        <Bild id={k.data.fotos[0]} format={i === 1 ? '4 / 5' : '5 / 4'} sizes="(min-width: 64rem) 55vw, 100vw" class="kueche-bild" />
        <div class="kueche-text einblenden">
          <h2 id={`k-${k.id}`}>{k.data.name}</h2>
          <p>{texte[k.id]}</p>
          <a class="weiter" href={`/${k.id}`}>Zur Karte von {k.data.name}</a>
        </div>
      </section>
    ))}
  </div>

  <section class="mittag dunkel" aria-labelledby="mittag-titel">
    <div class="wrap mittag-innen einblenden">
      <h2 id="mittag-titel">Mittags von Montag bis Freitag</h2>
      <p class="lead">Zwischen 11 und 16 Uhr hat jede Küche drei Gerichte zum festen Preis, ab {ab}. Auf Wunsch ist jedes davon vegan.</p>
      <a class="weiter" href="/mittag">Der Mittagstisch</a>
    </div>
  </section>

  <section class="streifen" aria-labelledby="streifen-titel">
    <div class="wrap streifen-kopf">
      <h2 id="streifen-titel" class="streifen-titel">Aus unseren Küchen</h2>
      <a class="weiter" href="/galerie">Zur Galerie</a>
    </div>
    <ul class="streifen-liste" tabindex="0" aria-label="Fotos, seitlich scrollbar">
      {streifen.map((g, i) => (
        <li>
          <Bild id={g.data.foto} format={i % 3 === 1 ? '3 / 4' : '4 / 5'} sizes="(min-width: 64rem) 26vw, 70vw" einblenden={false} />
        </li>
      ))}
    </ul>
  </section>

  <section class="abschluss dunkel" aria-labelledby="abschluss-titel">
    <div class="abschluss-bild" data-placeholder-photo="PLACEHOLDER_PHOTO">
      <img src={url(abschluss, 2000)} srcset={srcset(abschluss)} sizes="100vw" alt={abschluss.alt} width={abschluss.breite} height={abschluss.hoehe} loading="lazy" decoding="async" />
    </div>
    <div class="wrap abschluss-text einblenden">
      <h2 id="abschluss-titel">Wir halten Ihren Tisch bereit.</h2>
      <p class="lead">Für die Mittagspause mit Kollegen, den Abend mit der Familie oder zu zweit.</p>
      <a class="knopf knopf--hell" href="/reservieren">Tisch reservieren</a>
      <p class="abschluss-adresse" set:html={markiere(`${site.adresse.strasse} · ${site.adresse.plz} ${site.adresse.ort}`)} />
    </div>
  </section>
</Basis>

<style>
  /* Intro */
  .intro {
    padding-block: var(--luft);
  }
  .intro-satz {
    max-width: 30ch;
    margin: 0 auto;
    font-family: var(--serif);
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    line-height: 1.2;
    text-align: center;
  }
  .intro-satz em {
    color: var(--messing);
  }

  /* Küchen im Wechsel */
  .kuechen {
    display: grid;
    gap: var(--luft);
    max-width: var(--breite);
    margin-inline: auto;
    padding-inline: var(--rand);
  }
  .kueche {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.25rem;
    align-items: center;
  }
  .kueche h2 {
    margin-bottom: 1.25rem;
  }
  .kueche p {
    font-size: 1.12rem;
    max-width: 34ch;
  }
  .kueche .weiter {
    margin-top: 0.75rem;
  }

  @media (min-width: 64rem) {
    .kueche {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: 6rem;
    }
    .kueche--2 {
      grid-template-columns: minmax(0, 4fr) minmax(0, 5fr);
    }
    .kueche--2 :global(.kueche-bild) {
      order: 2;
    }
    .kueche--2 .kueche-text {
      justify-self: end;
    }
    .kueche--3 {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    }
    .kueche--3 :global(.kueche-bild) {
      margin-left: calc(var(--rand) * -1);
    }
  }

  /* Mittag */
  .mittag {
    margin-top: var(--luft);
    padding-block: var(--luft);
    text-align: center;
  }
  .mittag-innen {
    display: grid;
    justify-items: center;
  }
  .mittag h2 {
    margin-bottom: 1.75rem;
  }
  .mittag h2 em {
    color: var(--messing-hell);
  }
  .mittag .lead {
    max-width: 40ch;
    margin-bottom: 2rem;
    color: #e6ddcd;
  }

  /* Galerie-Streifen */
  .streifen {
    padding-top: var(--luft);
  }
  .streifen-kopf {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 2.5rem;
  }
  .streifen-titel em {
    color: var(--messing);
  }
  .streifen-liste {
    display: flex;
    align-items: flex-end;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    margin: 0;
    padding: 0 var(--rand) 1rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--rand);
    scrollbar-width: thin;
    scrollbar-color: var(--messing) transparent;
  }
  .streifen-liste li {
    flex: 0 0 clamp(15rem, 70vw, 24rem);
    scroll-snap-align: start;
  }
  .streifen-liste li:nth-child(3n + 2) {
    flex-basis: clamp(13rem, 58vw, 19rem);
  }

  /* Abschluss */
  .abschluss {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 90svh;
    margin-top: var(--luft);
    overflow: hidden;
  }
  .abschluss-bild {
    position: absolute;
    inset: 0;
  }
  .abschluss-bild img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .abschluss::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #121815a6;
  }
  .abschluss-text {
    position: relative;
    z-index: 1;
    padding-block: var(--luft);
    text-align: center;
    display: grid;
    justify-items: center;
  }
  .abschluss h2 {
    margin-bottom: 1.5rem;
    max-width: 14ch;
  }
  .abschluss h2 em {
    color: var(--messing-hell);
  }
  .abschluss .lead {
    max-width: 38ch;
    margin-bottom: 2.25rem;
  }
  .abschluss-adresse {
    margin: 2rem 0 0;
    font-size: 0.92rem;
    color: #e6ddcd;
  }
</style>
