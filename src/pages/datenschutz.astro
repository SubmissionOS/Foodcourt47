---
import Basis from '../layouts/Basis.astro';
import { getEntry, render } from 'astro:content';

const seite = await getEntry('seiten', 'datenschutz');
if (!seite) throw new Error('Inhalt src/content/seiten/datenschutz.md fehlt');
const { Content } = await render(seite);
---
<Basis titel="Datenschutz" kopf="solide" beschreibung="Datenschutzerklärung des Foodcourt47 Hammerbrook (Entwurf).">
  <article class="wrap recht">
    <h1>{seite.data.titel}</h1>
    <p class="stand">Stand {seite.data.stand}</p>
    <div class="prosa">
      <Content />
    </div>
  </article>
</Basis>

<style>
  .recht {
    max-width: 52rem;
    padding-top: 9.5rem;
  }
  .recht h1 {
    font-size: clamp(1.9rem, 6.5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    text-transform: none;
    hyphens: auto;
    overflow-wrap: break-word;
    margin-bottom: 1.25rem;
  }
  .stand {
    margin-bottom: 2.5rem;
    color: var(--rauch);
  }
  .prosa :global(p:first-child) {
    padding: 1rem 1.25rem;
    background: var(--leinen);
  }
</style>
