---
import Basis from '../layouts/Basis.astro';
import Karte from '../components/Karte.astro';
import Bild from '../components/Bild.astro';
import SeitenHero from '../components/SeitenHero.astro';
import { alleKuechen } from '../lib/kuechen';

const kuechen = await alleKuechen();
---
<Basis
  titel="Speisekarte"
  beschreibung="Speisekarte des Foodcourt47 Hammerbrook mit Preisen: Mittagskarten Mo–Fr 11–16 Uhr und Abendkarten von Cucino Italiano, Manju und Sushify."
>
  <SeitenHero foto="abend-tisch" titel="Speisekarte" satz="Drei Küchen, eine Karte. Mittags gelten feste Preise, danach die Abendkarten." />

  <nav class="wrap inhalt" aria-label="Küchen auf dieser Seite">
    {kuechen.map((k, i) => (
      <>
        {i > 0 && <span class="inhalt-punkt" aria-hidden="true">·</span>}
        <a href={`#${k.id}`} style={`--akzent: var(--k-${k.id})`}>{k.data.name}</a>
      </>
    ))}
  </nav>

  {kuechen.map((k) => (
    <section class="sk" id={k.id} style={`--akzent: var(--k-${k.id})`} aria-labelledby={`sk-${k.id}`}>
      <Bild id={k.data.fotos[0]} format="21 / 8" sizes="100vw" class="sk-band" />
      <header class="wrap sk-kopf">

        <h2 id={`sk-${k.id}`}>{k.data.name}</h2>
        <a class="weiter" href={`/${k.id}`}>Mehr über {k.data.name}</a>
      </header>
      <div class="wrap sk-karten">
        {k.data.karten.map((c) => (
          <section class="sk-karte" aria-labelledby={`sk-${k.id}-${c.id}`}>
            <h3 id={`sk-${k.id}-${c.id}`} class="sk-karte-titel">
              {c.titel} <span class="sk-zeit">{c.zeit}</span>
            </h3>
            <Karte karte={c} ebene="h4" spalten={c.sektionen.length > 2} />
          </section>
        ))}
      </div>
    </section>
  ))}

  <p class="wrap sk-fuss"><span class="sk-vegan">Jedes Gericht gibt es auf Wunsch vegan.</span> Informationen zu Allergenen und Zusatzstoffen erhalten Sie vor Ort bei unserem Team.</p>
</Basis>

<style>
  .inhalt {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
    padding-block: 4rem 0;
    font-family: var(--serif);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }
  .inhalt a {
    text-decoration: none;
    transition: color 300ms var(--weich);
  }
  .inhalt a:hover {
    color: var(--akzent);
    font-style: italic;
  }
  .inhalt-punkt {
    color: var(--messing);
  }

  .sk {
    padding-top: var(--luft);
    scroll-margin-top: 4rem;
  }
  .sk-kopf {
    display: grid;
    justify-items: center;
    padding-block: 4rem 3.5rem;
    text-align: center;
  }
  .sk-kopf h2 {
    margin-bottom: 1.5rem;
  }
  .sk-karten {
    display: grid;
    gap: 5rem;
  }
  .sk-karte-titel {
    margin-bottom: 2.5rem;
    font-size: clamp(1.9rem, 3vw, 2.5rem);
    text-align: center;
  }
  .sk-karte-titel .sk-zeit {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.55em;
    color: var(--akzent);
  }
  .sk-fuss {
    padding-block: var(--luft) 0;
    text-align: center;
    font-size: 1.25rem;
  }
  .sk-fuss .sk-vegan {
    display: block;
    margin-bottom: 0.75rem;
    font-size: 1.4rem;
  }
  .sk-fuss {
    max-width: none;
  }
</style>
