---
import Basis from '../layouts/Basis.astro';
import Bild from '../components/Bild.astro';
import SeitenHero from '../components/SeitenHero.astro';
import { site, zeiten } from '../lib/site';
import { markiere } from '../lib/format';
---
<Basis
  titel="Tisch reservieren"
  krume="Reservieren"
  heroFotos={['tisch-teilen']}
  ogFoto="tisch-teilen"
  beschreibung="Tisch im Foodcourt47 Hammerbrook online reservieren. Pizza, Curry und Sushi an einem Tisch, familienfreundlich, alle Gerichte auf Wunsch vegan."
>
  <SeitenHero foto="tisch-teilen" titel="Ihr Tisch" satz="Reservieren Sie online. Wir freuen uns auf Sie.">
    <a class="knopf knopf--hell r-hero-knopf" href={site.reservierungUrl} target="_blank" rel="noopener">
      Online reservieren<span class="nur-sr"> (öffnet neues Fenster)</span>
    </a>
  </SeitenHero>

  <section class="wrap r" aria-labelledby="r-titel">
    <div class="r-text einblenden">
      <h2 id="r-titel">Gut zu wissen</h2>
      <p class="lead">Die Online-Reservierung läuft über aleno. Erst mit dem Klick auf den Button werden Daten an aleno übertragen.</p>
      <p>Kinder sind willkommen, und jedes Gericht gibt es auf Wunsch vegan. Für Gruppen ab acht Personen und für Feiern rufen Sie uns bitte an, dann planen wir Tische und Ablauf gemeinsam.</p>
      <dl class="r-daten">
        <div><dt>Telefon</dt><dd set:html={markiere(site.telefon)} /></div>
        <div><dt>Adresse</dt><dd set:html={markiere(`${site.adresse.strasse}, ${site.adresse.plz} ${site.adresse.ort}`)} /></div>
        <div><dt>Mittag</dt><dd>{site.mittag.tage}, 11 bis 16 Uhr</dd></div>
        <div><dt>Öffnungszeiten</dt><dd>{zeiten.map((z) => <>{z}<br /></>)}</dd></div>
      </dl>
      <a class="knopf" href={site.reservierungUrl} target="_blank" rel="noopener">Online reservieren<span class="nur-sr"> (öffnet neues Fenster)</span></a>
    </div>
    <Bild id="abend-tisch" format="4 / 5" sizes="(min-width: 64rem) 40vw, 100vw" />
  </section>
</Basis>

<style>
  .r-hero-knopf {
    margin-top: 2rem;
  }
  .r {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4rem;
    padding-top: var(--luft);
    align-items: center;
  }
  .r h2 {
    margin-bottom: 2rem;
  }
  .r h2 em {
    color: var(--messing);
  }
  .r-daten {
    display: grid;
    gap: 1.1rem;
    margin: 2.5rem 0 3rem;
  }
  .r-daten div {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid #1d1b181f;
  }
  .r-daten dt {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--messing);
  }
  .r-daten dd {
    margin: 0;
  }
  @media (min-width: 64rem) {
    .r {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 7rem;
    }
  }
</style>
