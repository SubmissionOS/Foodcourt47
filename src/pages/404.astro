---
import Basis from '../layouts/Basis.astro';
import SeitenHero from '../components/SeitenHero.astro';
---
<Basis titel="Seite nicht gefunden" beschreibung="Diese Seite gibt es nicht. Zurück zur Startseite des Foodcourt47 Hammerbrook.">
  <SeitenHero foto="abend-tisch" titel="Dieser Tisch ist leer." satz="Die Seite gibt es nicht. Vielleicht finden Sie hier, was Sie suchen.">
    <p class="wege">
      <a class="knopf knopf--hell" href="/">Zur Startseite</a>
      <a class="weiter" href="/speisekarte">Speisekarte</a>
    </p>
  </SeitenHero>
</Basis>

<style>
  .wege {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 2rem;
  }
</style>
