---
import Basis from '../layouts/Basis.astro';
import Karte from '../components/Karte.astro';
import Bild from '../components/Bild.astro';
import SeitenHero from '../components/SeitenHero.astro';
import { alleKuechen, mittagskarte, abPreis } from '../lib/kuechen';
import { preis } from '../lib/format';

const kuechen = await alleKuechen();
const ab = preis(abPreis(kuechen));
---
<Basis
  titel="Mittagstisch Mo–Fr 11–16 Uhr"
  beschreibung={`Mittagstisch im Foodcourt47 Hammerbrook: Pizza, Curry und Sushi Mo–Fr 11–16 Uhr zum festen Preis, ab ${ab}.`}
>
  <SeitenHero foto="cucino-pasta" vorzeile="Mittagstisch" titel="Mittag in <em>Hammerbrook</em>" satz={`Montag bis Freitag, 11 bis 16 Uhr. Drei Küchen, feste Preise ab ${ab}.`} />

  <section class="wrap m-intro einblenden" aria-label="Einleitung">
    <p>Für die Mittagspause zwischen zwei Terminen oder mit dem ganzen Team: Jede Küche hält mittags drei Gerichte bereit. <em>Auf Wunsch ist jedes davon vegan.</em></p>
  </section>

  {kuechen.map((k, i) => {
    const karte = mittagskarte(k);
    return karte && (
      <section class:list={['m-kueche wrap', { 'm-kueche--rechts': i % 2 === 1 }]} style={`--akzent: var(--k-${k.id})`} aria-labelledby={`m-${k.id}`}>
        <Bild id={k.data.fotos[0]} format="4 / 5" sizes="(min-width: 64rem) 34vw, 100vw" class="m-bild" />
        <div class="m-karte">
          <span class="vorzeile">{k.data.kueche}</span>
          <h2 id={`m-${k.id}`}>{k.data.name}</h2>
          <Karte karte={karte} />
          <a class="weiter" href={`/${k.id}`}>Ganze Karte von {k.data.name}</a>
        </div>
      </section>
    );
  })}

  <section class="m-schluss wrap" aria-label="Reservieren">
    <p class="m-schluss-satz">Mit mehreren Kollegen unterwegs? <em>Reservieren Sie vorab.</em></p>
    <a class="knopf" href="/reservieren">Tisch reservieren</a>
  </section>
</Basis>

<style>
  .m-intro {
    padding-block: var(--luft) calc(var(--luft) * 0.6);
  }
  .m-intro p {
    max-width: 32ch;
    margin: 0 auto;
    font-family: var(--serif);
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1.25;
    text-align: center;
  }
  .m-intro em {
    color: var(--messing);
  }

  .m-kueche {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    padding-block: calc(var(--luft) * 0.6);
    align-items: center;
  }
  .m-karte h2 {
    margin-bottom: 2rem;
  }
  .m-karte :global(.karte) {
    margin-inline: 0;
  }
  .m-karte :global(.karte .karte-waehrung) {
    text-align: left;
    margin-top: 1.5rem;
  }
  .m-karte .weiter {
    margin-top: 2rem;
  }
  @media (min-width: 64rem) {
    .m-kueche {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 6rem;
    }
    .m-kueche--rechts {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    }
    .m-kueche--rechts :global(.m-bild) {
      order: 2;
    }
  }

  .m-schluss {
    display: grid;
    justify-items: center;
    gap: 2rem;
    padding-block: var(--luft) 0;
    text-align: center;
  }
  .m-schluss-satz {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3.4vw, 2.75rem);
    line-height: 1.2;
    max-width: 24ch;
  }
  .m-schluss-satz em {
    color: var(--messing);
  }
</style>
