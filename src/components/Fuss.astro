---
import { site, zeiten } from '../lib/site';
import { markiere } from '../lib/format';

const i = site.impressum;
const a = site.adresse;
---
<footer class="fuss dunkel">
  <div class="wrap">
    <div class="fuss-raster">
      <div>
        <h2 class="fuss-titel">Besuch</h2>
        <address>
          <Fragment set:html={markiere(a.strasse)} /><br />
          <Fragment set:html={markiere(`${a.plz} ${a.ort}`)} />
        </address>
      </div>
      <div>
        <h2 class="fuss-titel">Zeiten</h2>
        <p>{zeiten.map((z) => <>{z}<br /></>)}Mittagstisch Mo–Fr 11–16 Uhr</p>
      </div>
      <div>
        <h2 class="fuss-titel">Kontakt</h2>
        <p class="fuss-kontakt">
          <a href={`tel:+49${site.telefon.replace(/^0/, '').replace(/\s/g, '')}`}>{site.telefon}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
      <nav aria-label="Küchen und Seiten">
        <h2 class="fuss-titel">Entdecken</h2>
        <ul>
          <li><a href="/cucino-italiano">Cucino Italiano</a></li>
          <li><a href="/manju">Manju</a></li>
          <li><a href="/sushify">Sushify</a></li>
          <li><a href="/speisekarte">Speisekarte</a></li>
          <li><a href="/galerie">Galerie</a></li>
        </ul>
      </nav>
    </div>

    <div class="fuss-unten">
      <span class="fuss-logo">Foodcourt<span class="fuss-nr">47</span></span>
      <span>{i.firma} · {i.strasse}, {i.plzOrt} · {i.gericht} {i.register}</span>
      <span class="fuss-recht">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .fuss {
    padding-top: 4.5rem;
    border-top: 1px solid #f4eee41f;
    font-size: 0.95rem;
  }
  .fuss-raster {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.25rem;
    padding-block: 0 3.5rem;
  }
  .fuss-titel {
    margin-bottom: 0.7rem;
    font-family: var(--display);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--messing-hell);
  }
  address {
    font-style: normal;
  }
  .fuss p {
    margin: 0;
  }
  .fuss ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fuss li a,
  .fuss-kontakt a,
  .fuss-recht a {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
  }
  .fuss-kontakt a {
    display: flex;
  }
  .fuss a:not(.knopf) {
    text-decoration: none;
  }
  .fuss a:not(.knopf):hover {
    text-decoration: underline;
  }
  .fuss-unten {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.75rem 2.25rem;
    border-top: 1px solid #f4eee426;
    font-size: 0.82rem;
    color: #cfc5b4;
  }
  .fuss-nr {
    font-weight: 400;
  }
  .fuss-logo {
    font-family: var(--display);
    font-size: 1.15rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--creme);
  }
  .fuss-recht {
    display: flex;
    gap: 1.5rem;
  }
  @media (min-width: 40rem) {
    .fuss-raster {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .fuss-raster {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
