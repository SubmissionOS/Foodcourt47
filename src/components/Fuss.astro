---
import { site, zeiten } from '../lib/site';
import { markiere } from '../lib/format';

const i = site.impressum;
const a = site.adresse;
---
<footer class="fuss dunkel">
  <div class="wrap">
    <div class="fuss-raster">
      <div>
        <h2 class="fuss-titel">Besuch</h2>
        <address>
          <Fragment set:html={markiere(a.strasse)} /><br />
          <Fragment set:html={markiere(`${a.plz} ${a.ort}`)} />
        </address>
      </div>
      <div>
        <h2 class="fuss-titel">Zeiten</h2>
        <p>{zeiten.map((z) => <>{z}<br /></>)}Mittagstisch Mo–Fr 11–16 Uhr</p>
      </div>
      <div>
        <h2 class="fuss-titel">Kontakt</h2>
        <p><Fragment set:html={markiere(site.telefon)} /><br /><Fragment set:html={markiere(site.email)} /></p>
      </div>
      <nav aria-label="Küchen und Seiten">
        <h2 class="fuss-titel">Entdecken</h2>
        <ul>
          <li><a href="/cucino-italiano">Cucino Italiano</a></li>
          <li><a href="/manju">Manju</a></li>
          <li><a href="/sushify">Sushify</a></li>
          <li><a href="/speisekarte">Speisekarte</a></li>
          <li><a href="/galerie">Galerie</a></li>
        </ul>
      </nav>
    </div>

    <div class="fuss-unten">
      <span class="fuss-logo">Foodcourt<em>47</em></span>
      <span>{i.firma} · {i.strasse}, {i.plzOrt} · {i.gericht} {i.register}</span>
      <span class="fuss-recht">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .fuss {
    padding-top: 4.5rem;
    border-top: 1px solid #f4eee41f;
    font-size: 0.95rem;
  }
  .fuss-raster {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.25rem;
    padding-block: 0 3.5rem;
  }
  .fuss-titel {
    margin-bottom: 0.6rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--messing-hell);
  }
  address {
    font-style: normal;
  }
  .fuss p {
    margin: 0;
  }
  .fuss ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fuss li + li {
    margin-top: 0.2rem;
  }
  .fuss a:not(.knopf) {
    text-decoration: none;
  }
  .fuss a:not(.knopf):hover {
    text-decoration: underline;
  }
  .fuss-unten {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.75rem 2.25rem;
    border-top: 1px solid #f4eee426;
    font-size: 0.82rem;
    color: #cfc5b4;
  }
  .fuss-logo {
    font-family: var(--serif);
    font-size: 1.5rem;
    color: var(--creme);
  }
  .fuss-recht {
    display: flex;
    gap: 1.5rem;
  }
  @media (min-width: 40rem) {
    .fuss-raster {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .fuss-raster {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
