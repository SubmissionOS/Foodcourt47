---
// Küchen-Abschnitt: drei Wörter, das Foto wechselt je Küche (Hover, Fokus, mobil automatisch)
import type { Kueche } from '../lib/kuechen';
import { foto, url, srcset } from '../lib/fotos';
import { serie } from '../lib/serie';

interface Props {
  kuechen: Kueche[];
}
const { kuechen } = Astro.props;

const eintraege = await Promise.all(
  serie.map(async (s) => ({
    ...s,
    f: await foto(s.foto),
    k: kuechen.find((k) => k.id === s.id)!,
  })),
);
---
<section class="wahl dunkel" aria-labelledby="wahl-titel" data-wahl data-aktiv="0">
  <div class="ebenen" aria-hidden="true">
    {eintraege.map(({ id, f }, i) => (
      <div class:list={['ebene serie-foto', { 'ist-aktiv': i === 0 }]} data-ebene={i} data-kueche={id} data-placeholder-photo={f.stock ? 'PLACEHOLDER_PHOTO' : undefined}>
        <img src={url(f, 2000)} srcset={srcset(f)} sizes="100vw" alt="" width={f.breite} height={f.hoehe} loading="lazy" decoding="async" />
      </div>
    ))}
  </div>
  <div class="verlauf"></div>

  <div class="wrap wahl-inhalt">
    <h2 id="wahl-titel" class="woerter">
      {eintraege.map(({ id, wort }, i) => (
        <a class:list={['wort', { 'ist-aktiv': i === 0 }]} href={`/${id}`} data-wort={i}>{wort}.</a>
      ))}
    </h2>
    <div class="texte">
      {eintraege.map(({ id, k }, i) => (
        <div class:list={['text', { 'ist-aktiv': i === 0 }]} data-text={i} style={`--akzent: var(--k-${id})`}>
          <p>{k.data.kurztext}</p>
          <a class="weiter" href={`/${id}`} tabindex={i === 0 ? undefined : -1}>Zur Karte von {k.data.name}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const wahl = document.querySelector<HTMLElement>('[data-wahl]');
  if (wahl) {
    const ebenen = [...wahl.querySelectorAll<HTMLElement>('[data-ebene]')];
    const woerter = [...wahl.querySelectorAll<HTMLElement>('[data-wort]')];
    const texte = [...wahl.querySelectorAll<HTMLElement>('[data-text]')];
    const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    let aktiv = 0;
    let takt: number | undefined;

    const setze = (i: number) => {
      aktiv = i;
      wahl.dataset.aktiv = String(i);
      ebenen.forEach((e, n) => e.classList.toggle('ist-aktiv', n === i));
      woerter.forEach((w, n) => w.classList.toggle('ist-aktiv', n === i));
      texte.forEach((t, n) => {
        t.classList.toggle('ist-aktiv', n === i);
        t.querySelector('a')?.setAttribute('tabindex', n === i ? '0' : '-1');
      });
    };

    const stopp = () => {
      if (takt) window.clearInterval(takt);
      takt = undefined;
    };

    woerter.forEach((w, i) => {
      w.addEventListener('mouseenter', () => setze(i));
      w.addEventListener('focus', () => {
        setze(i);
        stopp();
      });
    });

    // Auf Touch-Geräten wechselt das Foto automatisch, solange der Abschnitt sichtbar ist
    if (!hover && !ruhig) {
      const beobachter = new IntersectionObserver(
        ([e]) => {
          stopp();
          if (e.isIntersecting) takt = window.setInterval(() => setze((aktiv + 1) % ebenen.length), 2800);
        },
        { threshold: 0.35 },
      );
      beobachter.observe(wahl);
    }

    // Nur für Screenshots: ?a=1 wählt die Küche vor
    const start = Number(new URLSearchParams(location.search).get('a'));
    if (start > 0 && start < ebenen.length) setze(start);
  }
</script>

<style>
  .wahl {
    position: relative;
    display: grid;
    min-height: 100svh;
    overflow: hidden;
    background: #0b0d0c;
    color: var(--creme);
  }
  .ebenen {
    position: absolute;
    inset: 0;
    background: #000;
  }
  .ebene {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: #000;
    transition: opacity 700ms var(--weich);
  }
  .ebene.ist-aktiv {
    opacity: 1;
  }
  .verlauf {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to right, #0b0d0cf2 0%, #0b0d0cb3 50%, #0b0d0c59 100%),
      linear-gradient(to top, #0b0d0ccc 0%, #0b0d0c00 50%);
  }
  .wahl-inhalt {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: center;
    gap: 2.5rem;
    padding-block: 6rem;
  }
  .woerter {
    display: grid;
    justify-items: start;
    margin: 0;
    font-family: 'Archivo', 'Arial Black', system-ui, sans-serif;
    font-weight: 900;
    font-size: clamp(4rem, 22vw, 16rem);
    line-height: 0.96;
    letter-spacing: -0.045em;
  }
  .wort {
    color: #fff;
    text-decoration: none;
    opacity: 0.55;
    text-shadow: 0 2px 30px #0b0d0c99;
    transition: opacity 400ms var(--weich);
  }
  .wort.ist-aktiv,
  .wort:focus-visible {
    opacity: 1;
  }
  .wort:focus-visible {
    outline: 3px solid var(--messing-hell);
    outline-offset: 0.06em;
  }

  .texte {
    display: grid;
    min-height: 9rem;
  }
  .text {
    grid-area: 1 / 1;
    max-width: 36ch;
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.6rem);
    transition: opacity 500ms var(--weich), transform 500ms var(--weich), visibility 0s linear 500ms;
  }
  .text.ist-aktiv {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 500ms var(--weich) 150ms, transform 500ms var(--weich) 150ms, visibility 0s;
  }
  .text p {
    margin-bottom: 1.25rem;
    font-size: 1.15rem;
  }

  @media (min-width: 48rem) {
    .woerter {
      font-size: clamp(4rem, 15vw, 16rem);
    }
  }
</style>
