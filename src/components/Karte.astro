---
// Menükarte im Stil einer gedruckten Karte
import type { CollectionEntry } from 'astro:content';
import { preis, markiere } from '../lib/format';

type Karte = CollectionEntry<'kuechen'>['data']['karten'][number];
interface Props {
  karte: Karte;
  ebene?: 'h3' | 'h4';
  spalten?: boolean;
}
const { karte, ebene = 'h3', spalten = false } = Astro.props;
const Titel = ebene;
const zahl = (p: number | null) => (p === null ? '[Preis]' : preis(p).replace(/\s?€/, ''));
---
<div class:list={['karte', { 'karte--spalten': spalten }]}>
  {karte.hinweis && <p class="karte-hinweis" set:html={markiere(karte.hinweis)} />}
  {karte.sektionen.map((s) => (
    <section class="karte-sektion">
      <Titel class="karte-titel" set:html={markiere(s.titel)} />
      <ul>
        {s.gerichte.map((g) => (
          <li class="gericht">
            <span class="gericht-name" set:html={markiere(g.name)} />
            <span class="gericht-preis" set:html={markiere(zahl(g.preis))} />
            {g.beschreibung && <span class="gericht-text" set:html={markiere(g.beschreibung)} />}
          </li>
        ))}
      </ul>
    </section>
  ))}
  <p class="karte-waehrung">Preise in Euro inklusive Mehrwertsteuer</p>
</div>

<style>
  .karte {
    max-width: 44rem;
    margin-inline: auto;
  }
  .karte-hinweis {
    margin: 0 auto 3rem;
    text-align: center;
    font-size: 0.92rem;
    color: var(--rauch);
  }
  .karte-sektion + .karte-sektion {
    margin-top: 3.5rem;
  }
  .karte-titel {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.65rem;
    color: var(--akzent);
    text-align: center;
  }
  .karte-titel::before,
  .karte-titel::after {
    content: '';
    flex: 1;
    height: 1px;
    background: currentColor;
    opacity: 0.35;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gericht {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1.5rem;
    padding-block: 0.85rem;
  }
  .gericht-name {
    font-family: var(--serif);
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.25;
  }
  .gericht-preis {
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 500;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .gericht-text {
    grid-column: 1 / -1;
    margin-top: 0.15rem;
    font-size: 0.95rem;
    color: var(--rauch);
    max-width: 46ch;
  }
  .karte-waehrung {
    margin: 3rem auto 0;
    text-align: center;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--rauch);
  }

  @media (min-width: 64rem) {
    .karte--spalten {
      max-width: none;
      columns: 2;
      column-gap: 6rem;
    }
    .karte--spalten .karte-hinweis,
    .karte--spalten .karte-waehrung {
      column-span: all;
    }
    .karte--spalten .karte-sektion {
      break-inside: avoid;
      padding-bottom: 3.5rem;
    }
    .karte--spalten .karte-sektion + .karte-sektion {
      margin-top: 0;
    }
  }
</style>
