---
// Hero der Startseite: Foto-Triptychon der drei Küchen, Headline in Versalien unten links
import '@fontsource/archivo/900.css';
import { foto, url, srcset } from '../lib/fotos';
import { serie } from '../lib/serie';

const fotos = await Promise.all(serie.map(async (s) => ({ ...s, f: await foto(s.foto) })));
---
<section class="hero dunkel" aria-labelledby="hero-titel">
  <div class="tripel" aria-hidden="true">
    {fotos.map(({ id, f }) => (
      <div class="feld serie-foto" data-placeholder-photo={f.stock ? 'PLACEHOLDER_PHOTO' : undefined} data-kueche={id}>
        <img src={url(f, 1000)} srcset={srcset(f)} sizes="34vw" alt="" width={f.breite} height={f.hoehe} fetchpriority="high" />
      </div>
    ))}
  </div>
  <div class="verlauf"></div>
  <div class="hero-inhalt wrap">
    <h1 id="hero-titel">
      <span class="z">Pizza,</span> <span class="z">Curry</span> <span class="z z--und">und Sushi</span>
    </h1>
    <a class="knopf knopf--hell hero-knopf" href="/reservieren">Tisch reservieren</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    height: 100svh;
    min-height: 34rem;
    margin-top: -2rem;
    overflow: hidden;
    background: #0b0d0c;
    color: var(--creme);
  }
  .tripel {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
    background: #0b0d0c;
  }
  .verlauf {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to bottom, #0b0d0cb3 0%, #0b0d0c00 22%),
      linear-gradient(to top, #0b0d0cf2 0%, #0b0d0cb8 38%, #0b0d0c59 72%, #0b0d0c40 100%);
  }
  .hero-inhalt {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: end;
    gap: 2rem;
    padding-block: 8rem clamp(2rem, 6vh, 4.5rem);
  }
  h1 {
    margin: 0;
    font-family: 'Archivo', 'Arial Black', system-ui, sans-serif;
    font-weight: 900;
    font-size: clamp(3rem, 15vw, 15rem);
    line-height: 0.86;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    text-wrap: nowrap;
    color: #fff;
  }
  .z {
    display: block;
  }
  .hero-knopf {
    justify-self: start;
  }
  @media (min-width: 48rem) {
    h1 {
      font-size: clamp(3rem, 10.6vw, 15rem);
    }
    .z {
      display: inline;
    }
    .z--und {
      display: block;
    }
  }
</style>
