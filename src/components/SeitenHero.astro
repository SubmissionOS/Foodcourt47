---
// Einheitlicher Hero für alle Unterseiten: 50svh (mindestens 360px), Foto füllt die Fläche immer komplett
import { foto, url, srcset } from '../lib/fotos';

interface Props {
  foto: string;
  titel: string;
  satz?: string;
}
const { foto: fotoId, titel, satz } = Astro.props;
const f = await foto(fotoId);
---
<section class="s-hero dunkel" aria-labelledby="s-hero-titel">
  <div class="s-hero-bild" data-parallax data-placeholder-photo={f.stock ? 'PLACEHOLDER_PHOTO' : undefined}>
    <img src={url(f, 2400)} srcset={srcset(f)} sizes="100vw" alt={f.alt} width={f.breite} height={f.hoehe} fetchpriority="high" />
  </div>
  <div class="wrap s-hero-text">
    <h1 id="s-hero-titel">{titel}</h1>
    {satz && <p class="s-hero-satz">{satz}</p>}
    <slot />
  </div>
</section>

<style>
  .s-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: max(50svh, 360px);
    /* liegt unter dem Entwurfs-Banner, damit oben keine Kante entsteht */
    margin-top: -2rem;
    overflow: hidden;
    background: var(--kiefer);
  }
  .s-hero-bild {
    position: absolute;
    /* oben Reserve für den Parallax-Versatz, unten bündig */
    inset: -25% 0 0 0;
    transform: scale(1.06);
    transform-origin: center bottom;
    will-change: transform;
  }
  .s-hero-bild img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .s-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, #121815d9 0%, #12181573 45%, #12181559 100%),
      linear-gradient(to right, #12181566 0%, #12181500 60%);
  }
  .s-hero-text {
    position: relative;
    z-index: 1;
    padding-block: 6.5rem clamp(2rem, 6vh, 3.5rem);
  }
  .s-hero h1 {
    font-size: clamp(2.4rem, 7vw, 6rem);
  }
  .s-hero-satz {
    margin: 1rem 0 0;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    max-width: 44ch;
  }
</style>
