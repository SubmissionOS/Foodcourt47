---
// Foto aus src/content/fotos.json. Stockfotos tragen data-placeholder-photo (PLACEHOLDER_PHOTO).
import { foto, url, srcset } from '../lib/fotos';

interface Props {
  id: string;
  /** Seitenverhältnis des Ausschnitts, z. B. "4 / 5". Standard: Original */
  format?: string;
  sizes?: string;
  eager?: boolean;
  einblenden?: boolean;
  class?: string;
}
const { id, format, sizes = '100vw', eager = false, einblenden = true, class: klasse } = Astro.props;
const f = await foto(id);
const verhaeltnis = format ?? `${f.breite} / ${f.hoehe}`;
---
<figure
  class:list={['bild', klasse, { einblenden }]}
  style={`aspect-ratio: ${verhaeltnis}`}
  data-placeholder-photo={f.stock ? 'PLACEHOLDER_PHOTO' : undefined}
>
  <img
    src={url(f, 1600)}
    srcset={srcset(f)}
    sizes={sizes}
    alt={f.alt}
    width={f.breite}
    height={f.hoehe}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
    onerror="this.parentElement.classList.add('ist-fehlend');"
  />
  <span class="bild-ersatz" aria-hidden="true">{f.alt}</span>
</figure>

<style>
  .bild {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--leinen);
  }
  .bild img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bild-ersatz {
    display: none;
  }
  .ist-fehlend img {
    visibility: hidden;
  }
  .ist-fehlend .bild-ersatz {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    text-align: center;
  }
</style>
