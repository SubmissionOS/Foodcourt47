---
// Foto aus src/content/fotos.json im festen Rahmen. Stockfotos tragen data-placeholder-photo (PLACEHOLDER_PHOTO).
import Foto from './Foto.astro';
import { foto } from '../lib/fotos';

interface Props {
  id: string;
  /** Seitenverhältnis des Ausschnitts, z. B. "4 / 5". Standard: Original */
  format?: string;
  sizes?: string;
  eager?: boolean;
  einblenden?: boolean;
  class?: string;
}
const { id, format, sizes = '100vw', eager = false, einblenden = true, class: klasse } = Astro.props;
const f = await foto(id);
const verhaeltnis = format ?? `${f.breite} / ${f.hoehe}`;
---
<figure
  class:list={['bild', klasse, { einblenden }]}
  style={`aspect-ratio: ${verhaeltnis}`}
  data-placeholder-photo={f.stock ? 'PLACEHOLDER_PHOTO' : undefined}
>
  <Foto id={id} widths={[480, 720, 1080, 1600]} sizes={sizes} eager={eager} />
</figure>
