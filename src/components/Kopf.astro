---
import { site } from '../lib/site';

interface Props {
  modus: 'transparent' | 'solide';
}
const { modus } = Astro.props;

const links = [
  { href: '/cucino-italiano', label: 'Cucino Italiano' },
  { href: '/manju', label: 'Manju' },
  { href: '/sushify', label: 'Sushify' },
  { href: '/speisekarte', label: 'Speisekarte' },
  { href: '/mittag', label: 'Mittag' },
  { href: '/galerie', label: 'Galerie' },
  { href: '/kontakt', label: 'Kontakt' },
];
const pfad = Astro.url.pathname.replace(/\/$/, '') || '/';
const aktiv = (href: string) => (pfad === href ? 'page' : undefined);
---
<div class="entwurf">Designentwurf von GuddiWeb · noch nicht live · Angaben in [Klammern] fehlen noch</div>

<header class:list={['kopf', `kopf--${modus}`]} data-kopf>
  <div class="kopf-innen">
    <a class="logo" href="/" aria-label={`${site.name}, zur Startseite`}>
      Foodcourt<span class="logo-nr">47</span>
      <span class="logo-ort">Hammerbrook</span>
    </a>

    <nav class="nav" aria-label="Hauptnavigation">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={aktiv(l.href)}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <a class="knopf kopf-knopf" href="/reservieren">Tisch reservieren</a>

    <details class="mobil">
      <summary aria-label="Menü öffnen">
        <span class="mobil-linien" aria-hidden="true"></span>
      </summary>
      <div class="mobil-panel">
        <nav aria-label="Hauptnavigation mobil">
          <ul>
            <li><a href="/" aria-current={aktiv('/')}>Start</a></li>
            {links.map((l) => (
              <li><a href={l.href} aria-current={aktiv(l.href)}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="knopf knopf--hell" href="/reservieren">Tisch reservieren</a>
      </div>
    </details>
  </div>
</header>

<style>
  .entwurf {
    position: relative;
    z-index: 31;
    padding: 0.4rem var(--rand);
    background: var(--tinte);
    color: #d9cdb8;
    height: 2rem;
    font-size: 0.75rem;
    line-height: 1.2rem;
    letter-spacing: 0.03em;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .kopf {
    position: sticky;
    top: 0;
    z-index: 30;
    color: var(--tinte);
    background: var(--creme);
    transition: background-color 400ms var(--weich), color 400ms var(--weich), box-shadow 400ms var(--weich);
  }
  .kopf--transparent {
    position: fixed;
    top: 2rem;
    left: 0;
    right: 0;
    background: transparent;
    color: var(--creme);
  }
  .kopf--transparent::before {
    content: '';
    position: absolute;
    inset: 0 0 -3rem;
    background: linear-gradient(#0000004d, #0000);
    pointer-events: none;
    transition: opacity 400ms var(--weich);
  }
  .kopf--transparent:global(.ist-gescrollt) {
    top: 0;
    background: var(--creme);
    color: var(--tinte);
    box-shadow: 0 1px 0 #1d1b1814;
  }
  .kopf--transparent:global(.ist-gescrollt)::before {
    opacity: 0;
  }

  .kopf-innen {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: var(--breite);
    margin-inline: auto;
    padding: 1.1rem var(--rand);
  }

  .logo {
    display: grid;
    grid-template-columns: auto auto;
    justify-content: start;
    margin-right: auto;
    font-family: var(--serif);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .logo-nr {
    font-style: italic;
    margin-left: 0.05em;
  }
  .logo-ort {
    grid-column: 1 / -1;
    margin-top: 0.3rem;
    font-family: var(--sans);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.32em;
    opacity: 0.8;
  }

  .nav,
  .kopf-knopf {
    display: none;
  }
  .nav ul {
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav a {
    position: relative;
    font-size: 0.92rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms var(--weich);
  }
  .nav a:hover::after,
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .kopf--transparent .kopf-knopf {
    background: transparent;
    border-color: currentColor;
    color: inherit;
  }
  .kopf--transparent .kopf-knopf:hover,
  .kopf--transparent:global(.ist-gescrollt) .kopf-knopf {
    background: var(--tinte);
    border-color: var(--tinte);
    color: var(--creme);
  }
  .kopf-knopf {
    min-height: 2.75rem;
    padding: 0.6rem 1.4rem;
    font-size: 0.88rem;
  }

  .mobil summary {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    cursor: pointer;
    list-style: none;
  }
  .mobil summary::-webkit-details-marker {
    display: none;
  }
  .mobil-linien,
  .mobil-linien::before {
    display: block;
    width: 1.6rem;
    height: 1px;
    background: currentColor;
    transition: transform 300ms var(--weich);
  }
  .mobil-linien {
    position: relative;
    transform: translateY(-4px);
  }
  .mobil-linien::before {
    content: '';
    position: absolute;
    top: 8px;
  }
  .mobil[open] .mobil-linien {
    transform: rotate(45deg);
  }
  .mobil[open] .mobil-linien::before {
    top: 0;
    transform: rotate(-90deg);
  }
  .mobil-panel {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2.5rem;
    padding: 6rem var(--rand) 3rem;
    background: var(--kiefer);
    color: var(--creme);
  }
  .mobil[open] summary {
    position: relative;
    z-index: 2;
    color: var(--creme);
  }
  .mobil-panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mobil-panel a:not(.knopf) {
    display: block;
    padding-block: 0.3rem;
    font-family: var(--serif);
    font-size: 2.1rem;
    line-height: 1.2;
    text-decoration: none;
  }
  .mobil-panel a[aria-current='page'] {
    font-style: italic;
    color: var(--messing-hell);
  }
  .mobil-panel .knopf {
    align-self: flex-start;
  }

  @media (min-width: 72rem) {
    .nav,
    .kopf-knopf {
      display: block;
    }
    .kopf-knopf {
      display: inline-flex;
    }
    .mobil {
      display: none;
    }
  }
</style>
