---
import { site } from '../lib/site';

interface Props {
  /** "transparent": liegt über einem Hero-Foto. "solide": startet direkt als schwebende Leiste */
  modus: 'transparent' | 'solide';
}
const { modus } = Astro.props;
const fest = modus === 'solide';

const links = [
  { href: '/cucino-italiano', label: 'Cucino Italiano' },
  { href: '/manju', label: 'Manju' },
  { href: '/sushify', label: 'Sushify' },
  { href: '/speisekarte', label: 'Speisekarte' },
  { href: '/mittag', label: 'Mittag' },
  { href: '/galerie', label: 'Galerie' },
  { href: '/kontakt', label: 'Kontakt' },
];
const pfad = Astro.url.pathname.replace(/\/$/, '') || '/';
const aktiv = (href: string) => (pfad === href ? 'page' : undefined);
---
<div class="entwurf">Designentwurf von GuddiWeb · noch nicht live</div>

<header class:list={['kopf ist-oben', { 'ist-gescrollt ist-fest': fest }]} data-kopf data-fest={fest ? '' : undefined}>
  <div class="kopf-leiste">
    <a class="logo" href="/" aria-label={`${site.name}, zur Startseite`}>
      Foodcourt<span class="logo-nr">47</span>
    </a>

    <nav class="nav" aria-label="Hauptnavigation">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={aktiv(l.href)}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <a class="kopf-knopf" href="/reservieren">Reservieren</a>

    <details class="mobil">
      <summary aria-label="Menü öffnen">
        <span class="mobil-linien" aria-hidden="true"></span>
      </summary>
      <div class="mobil-panel">
        <nav aria-label="Hauptnavigation mobil">
          <ul>
            <li><a href="/" aria-current={aktiv('/')}>Start</a></li>
            {links.map((l) => (
              <li><a href={l.href} aria-current={aktiv(l.href)}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="knopf knopf--hell" href="/reservieren">Tisch reservieren</a>
        <p class="mobil-info">{site.adresse.strasse}, {site.adresse.plz} {site.adresse.ort}<br />{site.telefon}</p>
      </div>
    </details>
  </div>
</header>

<style>
  .entwurf {
    position: relative;
    z-index: 31;
    height: 2rem;
    padding: 0.4rem var(--rand);
    background: var(--tinte);
    color: #d9cdb8;
    font-size: 0.75rem;
    line-height: 1.2rem;
    letter-spacing: 0.03em;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Zustand 1: transparent über dem Hero, helle Schrift */
  .kopf {
    --abstand-seite: 0px;
    --abstand-oben: 2rem;
    position: fixed;
    top: var(--abstand-oben);
    left: var(--abstand-seite);
    right: var(--abstand-seite);
    z-index: 30;
    color: var(--creme);
    transition:
      top 500ms var(--weich),
      left 500ms var(--weich),
      right 500ms var(--weich),
      color 400ms var(--weich);
  }
  .kopf-leiste {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: var(--breite);
    margin-inline: auto;
    padding: 1.1rem var(--rand);
    border-radius: 12px;
    transition: padding 500ms var(--weich), box-shadow 500ms var(--weich), max-width 500ms var(--weich);
  }
  /* Glasfläche als eigene Ebene, damit das fixierte Mobil-Menü nicht eingesperrt wird */
  .kopf-leiste::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: #f4eee4c7;
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    opacity: 0;
    transition: opacity 500ms var(--weich);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .kopf-leiste::before {
      background: var(--creme);
    }
  }

  /* Zustand 2: schwebende Leiste */
  .kopf:global(.ist-gescrollt) {
    --abstand-seite: clamp(12px, 2vw, 32px);
    --abstand-oben: 16px;
    color: var(--tinte);
  }
  .kopf:global(.ist-gescrollt) .kopf-leiste {
    max-width: 1600px;
    padding: 0.7rem clamp(1rem, 2.2vw, 2rem);
    box-shadow: 0 12px 40px -12px #1d1b1826, 0 2px 8px -4px #1d1b1814;
  }
  .kopf:global(.ist-gescrollt) .kopf-leiste::before {
    opacity: 1;
  }
  /* Seiten ohne Hero: ganz oben schwebt die Leiste unter dem Banner */
  .kopf:global(.ist-fest.ist-oben) {
    --abstand-oben: calc(2rem + 12px);
  }

  .logo {
    margin-right: auto;
    font-family: var(--serif);
    font-size: 1.7rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
  .logo-nr {
    font-style: italic;
    margin-left: 0.04em;
  }

  .nav,
  .kopf-knopf {
    display: none;
  }
  .nav ul {
    display: flex;
    gap: clamp(1.1rem, 1.6vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav a,
  .kopf-knopf {
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav a {
    position: relative;
    padding-block: 0.4rem;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.2em;
    bottom: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms var(--weich);
  }
  .nav a:hover::after,
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .kopf-knopf {
    align-items: center;
    min-height: 2.6rem;
    padding: 0.55rem 1.3rem 0.5rem 1.5rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    transition: background-color 400ms var(--weich), color 400ms var(--weich), border-color 400ms var(--weich);
  }
  .kopf-knopf:hover {
    background: var(--creme);
    border-color: var(--creme);
    color: var(--tinte);
  }
  .kopf:global(.ist-gescrollt) .kopf-knopf {
    background: var(--tinte);
    border-color: var(--tinte);
    color: var(--creme);
  }
  .kopf:global(.ist-gescrollt) .kopf-knopf:hover {
    background: var(--messing);
    border-color: var(--messing);
  }

  /* Mobil: dieselbe schwebende Leiste, Menü als Overlay */
  .mobil summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
    list-style: none;
  }
  .mobil summary::-webkit-details-marker {
    display: none;
  }
  .mobil-linien,
  .mobil-linien::before {
    display: block;
    width: 1.5rem;
    height: 1px;
    background: currentColor;
    transition: transform 300ms var(--weich);
  }
  .mobil-linien {
    position: relative;
    transform: translateY(-4px);
  }
  .mobil-linien::before {
    content: '';
    position: absolute;
    top: 8px;
  }
  .mobil[open] .mobil-linien {
    transform: rotate(45deg);
  }
  .mobil[open] .mobil-linien::before {
    top: 0;
    transform: rotate(-90deg);
  }
  .mobil[open] summary {
    position: relative;
    z-index: 3;
    color: var(--creme);
  }
  .mobil-panel {
    position: fixed;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2.25rem;
    padding: 6rem var(--rand) 3rem;
    background: var(--kiefer);
    color: var(--creme);
    overflow-y: auto;
  }
  .mobil-panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mobil-panel a:not(.knopf) {
    display: block;
    padding-block: 0.3rem;
    font-family: var(--serif);
    font-size: 2.1rem;
    line-height: 1.2;
    text-decoration: none;
  }
  .mobil-panel a[aria-current='page'] {
    color: var(--messing-hell);
  }
  .mobil-panel .knopf {
    align-self: flex-start;
  }
  .mobil-info {
    margin: 0;
    font-size: 0.9rem;
    color: #cfc5b4;
  }
  /* Logo bleibt über dem offenen Menü lesbar */
  .kopf:has(.mobil[open]) .logo {
    position: relative;
    z-index: 3;
    color: var(--creme);
  }
  .kopf:has(.mobil[open]) .kopf-leiste::before {
    opacity: 0;
  }

  @media (min-width: 72rem) {
    .nav {
      display: block;
    }
    .kopf-knopf {
      display: inline-flex;
    }
    .mobil {
      display: none;
    }
  }
</style>
