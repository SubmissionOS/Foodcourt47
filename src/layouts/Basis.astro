---
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/700.css';
import '@fontsource/archivo/800.css';
import '@fontsource/archivo/900.css';
import '@fontsource/jost/300.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '../styles/global.css';
import Kopf from '../components/Kopf.astro';
import Fuss from '../components/Fuss.astro';
import { site } from '../lib/site';

interface Props {
  titel: string;
  beschreibung: string;
  /** Küchen-id für den leisen Akzent, z. B. "manju" */
  akzent?: string;
  /** "transparent": Header liegt über einem Hero-Foto */
  kopf?: 'transparent' | 'solide';
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogBild?: string;
}

const { titel, beschreibung, akzent, kopf = 'transparent', schema, ogBild } = Astro.props;
const voll = Astro.url.pathname === '/' ? `${site.name} · Pizza, Curry und Sushi in Hamburg` : `${titel} · ${site.name}`;
const kanonisch = new URL(Astro.url.pathname, Astro.site).href;
const bild = ogBild ?? 'https://foodcourt47.de/wp-content/uploads/2023/02/2.jpg';
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{voll}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={kanonisch} />
    {/* Entwurf: nicht indexieren. Vor dem Livegang entfernen. */}
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#1e2a24" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://images.unsplash.com" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={voll} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={kanonisch} />
    <meta property="og:image" content={bild} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body style={akzent ? `--akzent: var(--k-${akzent})` : undefined}>
    <a class="springen" href="#inhalt">Zum Inhalt springen</a>
    <Kopf modus={kopf} />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Fuss />
    <script>
      const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Header wird beim Scrollen solide
      const kopf = document.querySelector<HTMLElement>('[data-kopf]');
      const fest = kopf?.hasAttribute('data-fest') ?? false;
      const pruefen = () => {
        const oben = window.scrollY <= 40;
        kopf?.classList.toggle('ist-oben', oben);
        kopf?.classList.toggle('ist-gescrollt', fest || !oben);
      };
      pruefen();
      window.addEventListener('scroll', pruefen, { passive: true });

      // Bilder blenden beim Scrollen weich ein (?shot: sofort sichtbar, nur für Screenshots)
      if (new URLSearchParams(location.search).has('shot')) document.querySelectorAll('.einblenden').forEach((el) => el.classList.add('ist-sichtbar'));
      const beobachter = new IntersectionObserver(
        (eintraege) => {
          for (const e of eintraege) {
            if (e.isIntersecting) {
              e.target.classList.add('ist-sichtbar');
              beobachter.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.einblenden').forEach((el) => beobachter.observe(el));

      // Leichter Parallax im Hero
      const parallax = document.querySelectorAll<HTMLElement>('[data-parallax]');
      if (!ruhig && parallax.length) {
        let geplant = false;
        const bewegen = () => {
          geplant = false;
          const y = window.scrollY;
          parallax.forEach((el) => {
            if (y < window.innerHeight * 1.2) el.style.transform = `translate3d(0, ${Math.min(y * 0.18, el.offsetHeight * 0.18)}px, 0) scale(1.06)`;
          });
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!geplant) {
              geplant = true;
              requestAnimationFrame(bewegen);
            }
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>
